{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uclawos.org/spec/v0.1/schemas/agent.schema.json",
  "title": "UCP Agent Manifest",
  "description": "JSON Schema for U-ClawOS Protocol v0.1 agent.toml. See docs/14-UCP协议规范.md §4.",
  "type": "object",
  "required": ["meta", "install", "runtime", "capabilities"],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "display", "ucp_version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "minLength": 2,
          "maxLength": 64,
          "description": "全局唯一 id，小写字母+短横线"
        },
        "display": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string"
        },
        "maintainer": {
          "type": "string"
        },
        "ucp_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$",
          "description": "兼容的 UCP 协议版本号"
        },
        "description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "install": {
      "type": "object",
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["script", "npm", "pip", "binary", "docker"]
        },
        "windows": { "$ref": "#/$defs/platformInstall" },
        "mac": { "$ref": "#/$defs/platformInstall" },
        "linux": { "$ref": "#/$defs/platformInstall" },
        "offline": {
          "type": "object",
          "required": ["bundle_url", "bundle_sha256"],
          "properties": {
            "bundle_url": { "type": "string", "format": "uri" },
            "bundle_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
            "fallback_mirrors": {
              "type": "array",
              "items": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["http_mcp", "acp", "stdio_mcp", "http_api", "cli_oneshot"]
        },
        "endpoint": { "type": "string" },
        "health_check": { "type": "string" },
        "startup_cmd": { "type": "string" },
        "shutdown_cmd": { "type": "string" },
        "log_dir": { "type": "string" },
        "config_dir": { "type": "string" }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "tags": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "uniqueItems": true
        },
        "languages": {
          "type": "array",
          "items": { "type": "string", "minLength": 2, "maxLength": 5 }
        },
        "context_window": {
          "type": "integer",
          "minimum": 0
        },
        "streaming": { "type": "boolean" },
        "multimodal": { "type": "boolean" },
        "session_persistence": { "type": "boolean" }
      }
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "isolation_level": {
          "type": "string",
          "enum": ["process", "container", "none"]
        },
        "resource_limits": {
          "type": "object",
          "properties": {
            "max_memory_mb": { "type": "integer", "minimum": 0 },
            "max_cpu_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
            "max_runtime_minutes": { "type": "integer", "minimum": 0 }
          }
        },
        "network_policy": {
          "type": "string",
          "enum": ["full", "limited", "offline"]
        },
        "allowed_domains": {
          "type": "array",
          "items": { "type": "string" }
        },
        "filesystem_policy": {
          "type": "string",
          "enum": ["full", "scoped", "readonly"]
        },
        "working_dir": { "type": "string" }
      }
    },
    "uninstall": {
      "type": "object",
      "properties": {
        "windows": { "$ref": "#/$defs/platformUninstall" },
        "mac": { "$ref": "#/$defs/platformUninstall" },
        "linux": { "$ref": "#/$defs/platformUninstall" },
        "cleanup_dirs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cleanup_path": {
          "type": "array",
          "items": { "type": "string" }
        },
        "preserve_user_data": { "type": "boolean" }
      }
    },
    "health": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/healthCheck" }
        }
      }
    }
  },
  "$defs": {
    "platformInstall": {
      "type": "object",
      "required": ["cmd"],
      "properties": {
        "cmd": { "type": "string", "minLength": 1 },
        "prerequisites": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mirror": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "platformUninstall": {
      "type": "object",
      "required": ["cmd"],
      "properties": {
        "cmd": { "type": "string", "minLength": 1 }
      }
    },
    "healthCheck": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["command", "tcp_port", "http_get"]
        },
        "cmd": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "url": { "type": "string", "format": "uri" },
        "expected_status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "timeout_ms": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "command" } } },
          "then": { "required": ["cmd"] }
        },
        {
          "if": { "properties": { "type": { "const": "tcp_port" } } },
          "then": { "required": ["port"] }
        },
        {
          "if": { "properties": { "type": { "const": "http_get" } } },
          "then": { "required": ["url"] }
        }
      ]
    }
  }
}
